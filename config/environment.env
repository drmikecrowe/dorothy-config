# Shared environment variables across all shells
# Loaded by interactive.sh, interactive.fish, interactive.nu

# Editor configuration
EDITOR=nvim
MANPAGER="nvim +Man!"

# XDG Base Directory Specification
XDG_BIN_HOME=$HOME/.local/bin
XDG_CACHE_HOME=$HOME/.cache
XDG_CONFIG_HOME=$HOME/.config
XDG_DATA_HOME=$HOME/.local/share
XDG_STATE_HOME=$HOME/.local/state

# Dorothy theme
DOROTHY_THEME=starship
STARSHIP_CONFIG=$HOME/.config/dorothy/config/starship.toml

# Tool configuration
CARAPACE_BRIDGES=zsh,fish,bash,inshellisense
YDOTOOL_SOCKET=/tmp/.ydotool_socket
PYTHONWARNINGS=ignore
PNPM_HOME=$HOME/.local/share/pnpm

# Claude Code
ENABLE_LSP_TOOLS=1
# Render inline instead of on the alternate screen, so terminal and tmux
# scrollback receive the session output. Costs the fullscreen TUI + Ctrl+O.
CLAUDE_CODE_DISABLE_ALTERNATE_SCREEN=1

# Visual Studio Code
ELECTRON_TRASH=trash-cli

SHARP_IGNORE_GLOBAL_LIBVIPS=1

TMPDIR=/tmp

