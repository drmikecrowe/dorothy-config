# runtime artifacts
.bg-shell/
.gsd/
commands/.bg-shell/
commands/.gsd/
# Claude Code local settings and agent worktrees
.claude/

# private config — machine-local, holds literal credentials.
# NOT ignored: .gitattributes runs these through the strongbox clean filter, so
# they are committed encrypted. Ignoring them here would silently disable that.
# The decryption key is ~/.strongbox_keyring and is NOT in this repo -- back it
# up separately or a rebuilt machine cannot read any of this.
*.local/*.bak
# Exception: per-host files stay on their machine, unencrypted and uncommitted.
# config/interactive.sh sources config.local/interactive.$(uname -n).sh.
config.local/interactive.*.sh

