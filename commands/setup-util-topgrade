#!/usr/bin/env bash

# https://github.com/topgrade-rs/topgrade
# https://github.com/topgrade-rs/topgrade/releases

# topgrade-v17.9.0-aarch64-apple-darwin.tar.gz
# topgrade-v17.9.0-aarch64-unknown-linux-gnu.tar.gz
# topgrade-v17.9.0-aarch64-unknown-linux-musl.tar.gz
# topgrade-v17.9.0-armv7-unknown-linux-gnueabihf.tar.gz
# topgrade-v17.9.0-x86_64-apple-darwin.tar.gz
# topgrade-v17.9.0-x86_64-pc-windows-msvc.zip
# topgrade-v17.9.0-x86_64-unknown-freebsd.tar.gz
# topgrade-v17.9.0-x86_64-unknown-linux-gnu.tar.gz
# topgrade-v17.9.0-x86_64-unknown-linux-musl.tar.gz
# topgrade-v17.9.0-x86_64-unknown-openbsd.tar.gz
# topgrade_17.9.0_amd64.deb

# not in the arch repositories, only the AUR, however dorothy invokes AUR
# helpers via `sudo`, which `yay` and `paru` refuse, so prefer the download

function setup_util_topgrade() (
	source "$DOROTHY/sources/bash.bash"

	# improve performance for detectable utilities with conditional assets
	if setup-util --check --cli=topgrade "$@"; then
		return 0
	fi

	# setup
	local arch options=(
		--name='topgrade'
		--cli='topgrade'
		"$@"
		BREW='topgrade'
		CARGO='topgrade'
	)
	arch="$(__get_arch)"
	function __get_github_asset_url {
		local suffix="$1" regexp
		regexp="$(echo-escape-regexp -- "$suffix")$" || return $?
		github-download --dry --slug='topgrade-rs/topgrade' --latest --asset-regexp="$regexp" | echo-first-line || return $?
	}
	function __add_download_option {
		local suffix="$1" url
		url="$(__get_github_asset_url "$suffix")" || return $?
		options+=(
			DOWNLOAD="$url"
			DOWNLOAD_ARCHIVE_GLOB='topgrade'
		)
	}
	if __is_macos; then
		if [[ $arch == 'a64' ]]; then
			__add_download_option '-aarch64-apple-darwin.tar.gz' || :
		elif [[ $arch == 'x64' ]]; then
			__add_download_option '-x86_64-apple-darwin.tar.gz' || :
		fi
	elif __is_linux; then
		if [[ $arch == 'a64' ]]; then
			__add_download_option '-aarch64-unknown-linux-musl.tar.gz' || :
		elif [[ $arch == 'a32' ]]; then
			__add_download_option '-armv7-unknown-linux-gnueabihf.tar.gz' || :
		elif [[ $arch == 'x64' ]]; then
			__add_download_option '-x86_64-unknown-linux-musl.tar.gz' || :
		fi
	fi
	setup-util "${options[@]}"
)

# fire if invoked standalone
if [[ $0 == "${BASH_SOURCE[0]}" ]]; then
	setup_util_topgrade "$@"
fi
