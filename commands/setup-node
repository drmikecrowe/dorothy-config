#!/usr/bin/env bash
# Custom setup-node - Node.js managed via mise

source "$DOROTHY/sources/bash.bash"

function setup_node() (
	source "$DOROTHY/sources/config.sh"

	# setup.bash provides:
	local NPM_INSTALL=(
		pnpm
		typescript
		ts-node
	)
	local NODE_VERSIONS=(
    	24
    	22
	)
	load_dorothy_config 'setup.bash'

	# =====================================
	# Arguments

	function help {
		cat <<-EOF >&2
			ABOUT:
			Setup the Node.js ecosystem using mise.

			USAGE:
			setup-node [...options] [install|update|setup|configure]

			OPTIONS:
			--configure
			    Whether to prompt, confirm, or save configuration changes.
		EOF
		if [[ $# -ne 0 ]]; then
			__print_error "$@"
		fi
		return 22 # EINVAL 22 Invalid argument
	}

	# process
	local item option_configure=''
	while [[ $# -ne 0 ]]; do
		item="$1"
		shift
		case "$item" in
		'--help' | '-h') help ;;
		# `install` must not force configuration: `setup-system install` passes it
		# on every run, so forcing it here re-asked for the npm author name,
		# email, homepage and license each time, even when npm already had all
		# four. The detection below escalates to 'yes' when a value is actually
		# missing, which is the only time the prompts are useful. `configure`
		# remains the explicit way to re-answer them.
		'setup' | 'update' | 'install') ;;
		'configure') option_configure='yes' ;;
		'--no-configure'* | '--configure'*) __flag --source={item} --target={option_configure} --affirmative --coerce || return ;;
		'--'*) help 'An unrecognised flag was provided: ' --variable-value={item} ;;
		*) help 'An unrecognised argument was provided: ' --variable-value={item} ;;
		esac
	done

	# check
	if [[ ${#NPM_INSTALL[@]} -eq 0 && ${#NODE_VERSIONS[@]} -eq 0 ]]; then
		if [[ $option_configure == 'no' ]]; then
			__print_style --dim='Setup of Node.js ecosystem skipped (managed via mise).' || return
			return 0
		elif ! confirm --linger --negative --ppid=$$ -- 'Setup Node.js ecosystem (mise)?'; then
			return 0
		fi
	fi

	# =====================================
	# Start

	__print_style --h1='Setup Node.js (mise)' || return

	# =====================================
	# Install/Upgrade Node.js via mise

	__print_style --h2='Install Node.js LTS' || return
	# mise use -g installs the version and sets it as the global default.
	# Never install node/npm via the system package manager: a system npm in
	# /usr/bin makes `npm install -g` target /usr/lib/node_modules (EACCES)
	# whenever /usr/bin sorts ahead of the mise shims on PATH.
	mise use -g node@lts
	__print_style --g2='Install Node.js LTS' || return

	# =====================================
	# Configure npm

	# helper
	function configure_system_npm {
		__print_style --h2='Configure npm' || return
		npm config set init-author-name "$(
			ask --required --linger \
				--question='What is the profile name that you want to configure npm with?' \
				--default="$(get-profile name -- npm ... || :)"
		)"
		npm config set init-author-email "$(
			ask --required --linger \
				--question='What is the profile email that you want to configure npm with?' \
				--default="$(get-profile email -- npm ... || :)"
		)"
		npm config set init-author-url "$(
			ask --required --linger \
				--question='What is the profile homepage that you want to configure npm with?' \
				--default="$(get-profile url -- npm ... || :)"
		)"
		npm config set init-license "$(
			ask --required --linger \
				--question='What license do you want to configure npm to default to?' \
				--default="$(npm config get init-license)"
		)"
		__print_style --g2='Configure npm' || return
	}

	# check if npm config is needed
	if
		is-empty-value -- "$(npm config get init-author-name)" ||
			is-empty-value -- "$(npm config get init-author-email)" ||
			is-empty-value -- "$(npm config get init-author-url)" ||
			is-empty-value -- "$(npm config get init-license)"
	then
		option_configure='yes'
	fi

	# configure
	if [[ $option_configure == 'yes' ]]; then
		configure_system_npm
	fi

	# =====================================
	# Packages via npm

	if [[ ${#NPM_INSTALL[@]} -ne 0 ]]; then
		__print_style --h2='Node.js Packages' || return
		# pinned to mise's node so PATH ordering cannot pick a system npm
		mise exec node -- npm install -g "${NPM_INSTALL[@]}"
		__print_style --g2='Node.js Packages' || return
	fi

	# =====================================
	# Additional Node.js versions via mise

	if [[ ${#NODE_VERSIONS[@]} -ne 0 ]]; then
		__print_style --h2='Additional Node.js Versions' || return
		# `mise install`, not `mise use -g`: these are *additional* versions to
		# have available, not the global default. `mise use -g` rewrites the
		# global default every time, so this loop silently undid the
		# `mise use -g node@lts` above and left the last entry of NODE_VERSIONS
		# as the global node. That matters because npm installs global packages
		# per node version: with the default landing on a version that has none
		# of them, every run saw the whole global package list as missing and
		# reinstalled it.
		for version in "${NODE_VERSIONS[@]}"; do
			mise install "node@${version}"
		done
		__print_style --g2='Additional Node.js Versions' || return
	fi

	# =====================================
	# Finish

	__print_style --g1='Setup Node.js (mise)' || return
)

# fire if invoked standalone
if [[ $0 == "${BASH_SOURCE[0]}" ]]; then
	setup_node "$@"
fi
