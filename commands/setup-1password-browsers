#!/usr/bin/env bash
# Dorothy Command: setup-1password-browsers
# Purpose: Allow non-default browsers to talk to the 1Password desktop app.
#
# Migrated from the pyinfra bootstrap (system/apps_config.py) on 2026-09-02.
# 1Password refuses browser integration for any binary not on this list.

set -euo pipefail

BROWSERS=(
    vivaldi-bin
    zen
    zen-bin
    opera-developer
    opera
    brave
    brave-browser
    wavebox
    wavebox-bin
    browseros
)

TARGET=/etc/1password/custom_allowed_browsers

echo "==> $TARGET"
sudo mkdir -p "$(dirname "$TARGET")"

DESIRED=$(printf '%s\n' "${BROWSERS[@]}")
if [[ -f "$TARGET" ]] && [[ "$(cat "$TARGET")" == "$DESIRED" ]]; then
    echo "    already correct (${#BROWSERS[@]} browsers)"
else
    printf '%s\n' "$DESIRED" | sudo tee "$TARGET" >/dev/null
    # 1Password requires this to be root-owned and not group/world writable.
    sudo chown root:root "$TARGET"
    sudo chmod 0755 "$TARGET"
    echo "    wrote ${#BROWSERS[@]} browsers"
fi

echo
echo "==> verification"
ls -l "$TARGET"
